# 复制为 .env（chmod 600）后填【真实的 key 值】。.env 已被 .gitignore 排除，不会入库。
#
# ⛔ 下面最后一行是占位符，必须替换成真实值（64 位 hex）。
#    照抄占位符的后果：域名能打开，但侧栏空、发消息报"接口密钥无效或未注入"（接口全 401）。
#
# 值在哪：hermes 部署目录的 .env 里，变量名通常是 HERMES_API_SERVER_KEY 或 API_SERVER_KEY
#        （同一个 key；hermes 容器内部看到的名字是 API_SERVER_KEY）
#
# --- 一行取值（在 hermes 部署目录执行，替换 <HERMES_DIR>）---
#   KEY=$(grep -hE '^[[:space:]]*(HERMES_)?API_SERVER_KEY=' <HERMES_DIR>/.env | head -1 | sed 's/^[^=]*=//' | tr -d '\042\047\r ')
#   printf 'HERMES_API_SERVER_KEY=%s\n' "$KEY" > .env && chmod 600 .env
#   grep -i api_server <HERMES_DIR>/.env      # 上面的 grep 没结果时，用它看变量到底叫什么
#
# --- 自检 1：长度（应输出 64）---
#   awk -F= '/^HERMES_API_SERVER_KEY=/{print length($2)}' .env
#
# --- 自检 2：有效性（应输出 200）---
#   docker run --rm --network net_openclaw -e K="$(awk -F= '/^HERMES_API_SERVER_KEY=/{print $2}' .env)" \
#     alpine sh -c 'wget -qO- --header="Authorization: Bearer $K" "http://hermes:8642/api/sessions?limit=1" >/dev/null && echo 200'
HERMES_API_SERVER_KEY=REPLACE_ME_64位hex真实值
